// schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── Enums ────────────────────────────────────────────

enum TipoUsuario {
  PRODUTOR
  COMPRADOR
  AMBOS
}

enum TipoCusto {
  INSUMO
  MAO_DE_OBRA
  TRANSPORTE
  MANUTENCAO
  OUTRO
}

enum StatusAluguel {
  ATIVO
  CONCLUIDO
  CANCELADO
}

// ─── Models ───────────────────────────────────────────

model Usuario {
  id           String      @id @default(uuid())
  nome         String
  email        String      @unique
  senha        String
  tipoUsuario  TipoUsuario
  telefone     String?
  regiao       String?
  dataCadastro DateTime    @default(now())

  produtos                 Produto[]
  custos                   Custo[]
  simulacoes               PrecoJusto[]
  equipamentos             Equipamento[]
  sessions                 Session[]
  alugueis_como_locador    Aluguel[]     @relation("locador")
  alugueis_como_locatario  Aluguel[]     @relation("locatario")

  @@map("usuarios")
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  usuarioId String

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiresAt])
  @@map("sessoes")
}

model Produto {
  id             String   @id @default(uuid())
  usuarioId      String
  nome           String
  quantidade     Decimal  @db.Decimal(10, 3)
  unidadeMedida  String   // kg, ton, caixa, saca
  tipoCultivo    String   // organico | convencional
  regiao         String?
  descricao      String?  @db.Text
  preco          Decimal  @db.Decimal(10, 2)
  imagem         String?
  dataCadastro   DateTime @default(now())

  usuario      Usuario      @relation(fields: [usuarioId], references: [id])
  custos       Custo[]
  precosJustos PrecoJusto[]

  @@map("produtos")
}

model Custo {
  id               String    @id @default(uuid())
  produtoId        String?
  usuarioId        String
  tipo             TipoCusto
  descricao        String
  valor            Decimal   @db.Decimal(10, 2)
  quantidadeInsumo Decimal?  @db.Decimal(10, 3) // ex: 50 kg de fertilizante
  unidadeInsumo    String?                       // ex: "kg", "L", "unidade"
  dataInicio       DateTime?
  dataFim          DateTime?
  dataRegistro     DateTime  @default(now())

  produto Produto? @relation(fields: [produtoId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([produtoId])

  @@map("custos")
}

model PrecoJusto {
  id                  String   @id @default(uuid())
  produtoId           String?
  usuarioId           String
  insumos             Decimal  @db.Decimal(10, 2)
  maoDeObra           Decimal  @db.Decimal(10, 2)
  transporteBase      Decimal  @db.Decimal(10, 2)
  manutencao          Decimal  @db.Decimal(10, 2)
  distanciaKm         Decimal  @db.Decimal(10, 3)
  custoPorKm          Decimal  @db.Decimal(10, 2)
  quantidade          Decimal  @db.Decimal(10, 3)
  margem              Decimal  @db.Decimal(5, 2)
  oferta              Decimal  @db.Decimal(5, 2)
  demanda             Decimal  @db.Decimal(5, 2)
  custoTotal          Decimal  @db.Decimal(10, 2)
  custoUnitario       Decimal  @db.Decimal(10, 2)
  precoMinimo         Decimal  @db.Decimal(10, 2)
  precoIdeal          Decimal  @db.Decimal(10, 2)
  margemLucro         Decimal  @db.Decimal(5, 2)
  quantidadeProduzida Decimal  @db.Decimal(10, 3)
  moeda               String   @default("BRL")
  dataCalculo         DateTime @default(now())

  produto Produto? @relation(fields: [produtoId], references: [id])
  usuario Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([produtoId])

  @@map("precos_justos")
}

model Equipamento {
  id              String   @id @default(uuid())
  usuarioId       String
  nome            String
  descricao       String?  @db.Text
  tipo            String
  condicoes       String
  dias            Decimal  @db.Decimal(10, 2)
  imagem          String?
  valorDia        Decimal  @db.Decimal(10, 2)
  disponibilidade Boolean  @default(true)
  excluidoEm      DateTime?
  dataCadastro    DateTime @default(now())

  usuario  Usuario   @relation(fields: [usuarioId], references: [id])
  alugueis Aluguel[]

  @@map("equipamentos")
}

model Aluguel {
  id          String        @id @default(uuid())
  machineId   String        @map("equipamentoId")
  usuarioId   String        @map("locadorId")
  locatarioId String?       @map("locatarioId")
  tenant      String
  start       DateTime      @map("dataInicio")
  end         DateTime      @map("dataFim")
  dailyPrice  Decimal       @map("valorDiaria") @db.Decimal(10, 2)
  total       Decimal       @map("valorTotal") @db.Decimal(10, 2)
  notes       String?       @map("observacoes") @db.Text
  status      StatusAluguel @default(ATIVO)
  createdAt   DateTime      @default(now())
  finalizadoEm DateTime?

  equipamento Equipamento @relation(fields: [machineId], references: [id])
  locador     Usuario     @relation("locador", fields: [usuarioId], references: [id])
  locatario   Usuario?    @relation("locatario", fields: [locatarioId], references: [id])

  @@index([usuarioId])
  @@index([machineId])
  @@index([finalizadoEm])

  @@map("alugueis")
}